# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report/
/test-results/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# datos locales (DB + uploads)
# Se excluye el contenido, no el directorio: git no puede reincluir un archivo
# si su directorio padre está excluido.
/data/*
# …salvo los planes de batería, que son configuración versionable. El estado de
# avance de cada corrida (*.estado.json) sí queda fuera.
!/data/bateria-*.json
/data/*.estado.json
vendor/yt-dlp
vendor/yt-dlp.exe

# material de clientes: guiones, entregables y compilados que se importan al
# corpus. Nunca se versionan — son confidenciales y viven en la DB, no en git.
/*.pdf
/*.docx
/corpus-manifiesto.json

# Worker Whisper (Python) — runtime local, no versionar
worker/**/.venv/
**/__pycache__/
*.pyc
